<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= query %> - Domainlookup</title>

    <link href="/assets/css/info.css" rel="stylesheet">
</head>
<body>
    <div class="loader"></div>

    <%- include("partials/nav.ejs", { mainpage: false }) %>

    <div class="mainWrapper">
        <main>
            <div class="titlebar">
                <div class="title">
                    <h1><%= query%></h1>
                    <a href="https://<%= query %>" target="_blank" rel="noreferrer noopener" id="externalLink">
                        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#fefefe"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M20 4L12 12M20 4V8.5M20 4H15.5M19 12.5V16.8C19 17.9201 19 18.4802 18.782 18.908C18.5903 19.2843 18.2843 19.5903 17.908 19.782C17.4802 20 16.9201 20 15.8 20H7.2C6.0799 20 5.51984 20 5.09202 19.782C4.71569 19.5903 4.40973 19.2843 4.21799 18.908C4 18.4802 4 17.9201 4 16.8V8.2C4 7.0799 4 6.51984 4.21799 6.09202C4.40973 5.71569 4.71569 5.40973 5.09202 5.21799C5.51984 5 6.07989 5 7.2 5H11.5" stroke="#fefefe" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>
                    </a>
                </div>
                <div class="tabs">
                    <button type="button" class="clear tabs--tab -active" onclick="changeSection('whoislist');">Whois</button>
                    <%if (queryType === "domain") {%>
                        <button type="button" class="clear tabs--tab" onclick="changeSection('dnslist');">DNS</button>
                        <button type="button" class="clear tabs--tab" onclick="changeSection('otherlist');">Other</button>
                    <%}%>
                    <span class="tabs--line"></span>
                </div>
            </div>

            <div id="whoislist" class="boxlist _shown">
                <div class="listloader"><img src="/assets/img/loader.svg" alt="loader" class="loading"></div>
            </div>
            <div id="dnslist" class="boxlist">
                <div class="listloader"><img src="/assets/img/loader.svg" alt="loader" class="loading"></div>
            </div>
            <div id="otherlist" class="boxlist">
                <div class="listloader"><img src="/assets/img/loader.svg" alt="loader" class="loading"></div>
            </div>
        </main>
    </div>

    <input id="query" type="text" value="<%= query %>" style="display: none;">

    <script src="/assets/js/assets.js"></script>
    <script src="/assets/js/tabs.js"></script>
    <script src="/assets/js/infopage.js"></script>
    <% if (queryType === "domain") {%><script src="/assets/js/domain.js"></script><%}%>
    <% if (queryType === "tld") {%><script src="/assets/js/tld.js"></script><%}%>
</body>
</html>